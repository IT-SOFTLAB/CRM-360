generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  password            String
  role                String         @default("User")
  createdAt           DateTime       @default(now())
  category            String?
  department          String?
  invitationExpires   DateTime?
  invitationToken     String?        @unique
  isLocked            Boolean        @default(false)
  salesTeamId         String?
  status              String         @default("Active")
  adminId             String?
  outlookAccessToken  String?
  outlookEmail        String?
  outlookRefreshToken String?
  resetOtp            String?
  resetOtpExpiry      DateTime?
  organizationId      String         @default("orgA")
  customers           Customer[]
  leads               Lead[]
  notifications       Notification[]
  opportunities       Opportunity[]
  refreshTokens       RefreshToken[]
  ledTeams            SalesTeam[]    @relation("TeamLeader")
  savedFilters        SavedFilter[]
  admin               User?          @relation("UserToUser", fields: [adminId], references: [id])
  subordinates        User[]         @relation("UserToUser")
  salesTeam           SalesTeam?     @relation("TeamMembers", fields: [salesTeamId], references: [id])

  @@index([organizationId])
}

model Lead {
  id              String   @id @default(cuid())
  email           String?
  phone           String?
  status          String   @default("New")
  createdAt       DateTime @default(now())
  category        String
  company         String?
  contactName     String
  serviceType     String
  assignedUser    String?
  assignedUserId  String?
  source          String?
  linkedinId      String?
  dealValue       Float    @default(0)
  organizationId  String   @default("orgA")
  assignedUserRel User?    @relation(fields: [assignedUserId], references: [id])

  @@index([organizationId])
}

model Activity {
  id              String    @id @default(cuid())
  title           String
  description     String?
  type            String    @default("Task")
  date            DateTime
  time            String
  duration        Int
  startTime       DateTime?
  endTime         DateTime?
  salesperson     String?
  leadId          String?
  opportunityId   String?
  location        String?
  attendees       Json?
  isOutlookSynced Boolean   @default(false)
  outlookEventId  String?
  meetingUrl      String?
  done            Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organizationId  String    @default("orgA")

  @@index([organizationId])
}

model ReferralPipeline {
  id                String            @id @default(cuid())
  name              String
  sequence          Int
  color             String?
  isFinal           Boolean           @default(false)
  createdAt         DateTime          @default(now())
  organizationId    String            @default("orgA")
  referrals         Referral[]
  referralHistories ReferralHistory[]

  @@index([organizationId])
}

model Referral {
  id                String            @id @default(cuid())
  referralCode      String            @unique
  referrerId        String
  referrerName      String
  referrerCompany   String
  referredLeadName  String
  referredCompany   String
  referredEmail     String?
  referredPhone     String?
  rewardType        String
  rewardValue       Float
  rewardApproved    Boolean           @default(false)
  currentStageId    String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  createdById       String?
  organizationId    String            @default("orgA")
  currentStage      ReferralPipeline  @relation(fields: [currentStageId], references: [id])
  referralHistories ReferralHistory[]
  referralRewards   ReferralReward[]

  @@index([organizationId])
}

model ReferralHistory {
  id         String           @id @default(cuid())
  referralId String
  stageId    String
  changedBy  String
  remarks    String?
  createdAt  DateTime         @default(now())
  referral   Referral         @relation(fields: [referralId], references: [id])
  pipeline   ReferralPipeline @relation(fields: [stageId], references: [id])
}

model ReferralReward {
  id         String    @id @default(cuid())
  referralId String
  amount     Float
  rewardType String
  approved   Boolean   @default(false)
  approvedBy String?
  paid       Boolean   @default(false)
  paidDate   DateTime?
  referral   Referral  @relation(fields: [referralId], references: [id])
}

model Opportunity {
  id                     String    @id @default(cuid())
  leadId                 String?
  customerName           String
  company                String?
  email                  String?
  phone                  String?
  dealValue              Float
  stage                  String    @default("New")
  stageId                String?
  assignedSalesperson    String?
  expectedClosing        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  assignedSalespersonId  String?
  priority               Int       @default(0)
  tags                   String[]
  description            String?
  linkedinId             String?
  organizationId         String    @default("orgA")
  assignedSalespersonRel User?     @relation(fields: [assignedSalespersonId], references: [id])

  @@index([organizationId])
}

model Customer {
  id                     String   @id @default(cuid())
  opportunityId          String?
  customerName           String
  company                String?
  email                  String?
  phone                  String?
  dealValue              Float
  assignedSalesperson    String?
  status                 String   @default("Active")
  joinedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  assignedSalespersonId  String?
  organizationId         String   @default("orgA")
  assignedSalespersonRel User?    @relation(fields: [assignedSalespersonId], references: [id])

  @@index([organizationId])
}

model Quotation {
  id                          String          @id @default(uuid())
  quotationNumber             String          @unique
  opportunityId               String
  customerId                  String
  customerNameSnapshot        String
  customerCompanyNameSnapshot String
  customerEmailSnapshot       String
  customerPhoneSnapshot       String
  salesperson                 String
  quotationDate               DateTime
  expirationDate              DateTime
  paymentTerms                String
  currency                    String
  subtotal                    Float
  tax                         Float
  total                       Float
  notes                       String?
  status                      String          @default("Draft")
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  customerGstinSnapshot       String?
  billingAddressSnapshot      String?
  shippingAddressSnapshot     String?
  discountPercent             Float           @default(0.0)
  cgst                        Float           @default(0.0)
  sgst                        Float           @default(0.0)
  igst                        Float           @default(0.0)
  shippingCharge              Float           @default(0.0)
  otherCharges                Float           @default(0.0)
  roundOff                    Float           @default(0.0)
  termsConditions             String?
  internalNotes               String?
  organizationId              String          @default("orgA")
  items                       QuotationItem[]

  @@index([organizationId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  product     String
  description String
  quantity    Int
  unitPrice   Float
  tax         Float
  discount    Float
  subtotal    Float
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalesTeam {
  id             String   @id @default(cuid())
  name           String
  description    String?
  leaderId       String?
  category       String?
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  organizationId String   @default("orgA")
  leader         User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  members        User[]   @relation("TeamMembers")

  @@index([organizationId])
}

model CompanySettings {
  id             String   @id @default("global_settings")
  companyName    String   @default("Global CRM Cloud")
  logo           String?
  gst            String?
  address        String?
  phone          String?
  email          String?
  currency       String   @default("INR")
  timezone       String   @default("UTC")
  language       String   @default("English")
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logoText       String?  @default("CRM 360")
  primaryColor   String?  @default("#2563EB")
  secondaryColor String?  @default("#0F172A")
  organizationId String   @default("orgA")

  @@index([organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  userEmail      String?
  action         String
  module         String
  details        String
  ipAddress      String?
  createdAt      DateTime @default(now())
  organizationId String   @default("orgA")

  @@index([organizationId])
}

model EmailLog {
  id             String   @id
  recipientEmail String
  subject        String
  leadId         String?
  opportunityId  String?
  sentByUserId   String
  status         String   @default("Sent")
  errorMessage   String?
  attachments    String?
  emailBody      String
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  organizationId String   @default("orgA")

  @@index([organizationId])
}

model SavedFilter {
  id             String   @id @default(cuid())
  name           String
  filters        Json
  userId         String?
  createdAt      DateTime @default(now())
  organizationId String   @default("orgA")
  user           User?    @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model PipelineStage {
  id             String   @id @default(cuid())
  name           String   @unique
  order          Int
  createdAt      DateTime @default(now())
  organizationId String   @default("orgA")

  @@index([organizationId])
}

model OutlookIntegration {
  id             String   @id @default(cuid())
  organizationId String   @unique
  clientId       String
  clientSecret   String
  tenantId       String
  redirectUri    String
  isConfigured   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}
