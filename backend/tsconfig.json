{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "allowJs": true,

    "checkJs": false,

    "skipLibCheck": true,

    "types": [
      "node"
    ],

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*"
  ]
}